---
import Layout from '../layouts/Layout.astro';
import Snap from '../components/Snap.astro';
import { snapshot } from '../lib';
---
<Layout title="Page not found">
  <main class="wrap empty" style="padding:56px 24px 80px">
    <Snap s={snapshot('kitchen-roll-dog')} />
    <h1 style="font-size:40px;letter-spacing:-.02em;margin:0 0 8px">We can't find that page</h1>
    <p>It may have been renamed or removed. Have a look through all the recipes instead.</p>
    <a class="btn btn-red" href="/">See all recipes</a>
  </main>
</Layout>
